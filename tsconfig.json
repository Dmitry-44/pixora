{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["node"],
    "paths": {
      "@pixora/platform": ["./libs/platform/src/index.ts"],
      "@pixora/platform/*": ["./libs/platform/src/*"]
    }
  },
  "include": ["apps/**/*", "libs/**/*", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
